<%= turbo_frame_tag 'modal' %>
<section class="flex flex-row-reverse justify-around items-center p-32" id="chapters_all">
    <div>
        <%= image_tag("4884176.jpg", width: "500")%>
    </div>

    <div>
        <h1 class="text-center text-3xl font-bold text-chapterStrong">Capítulos</h1>
        <p class="text-center py-2 font-semibold text-chapterStrong">
        En esta sección podrás crear capítulos para organizar tus encuestas.<br>
        Cada capítulo debe abordar un tema de manera clara y estructurada,<br>
        facilitando el entendimiento y la organización de las preguntas.<br> 
        </p>

        <div class="flex justify-center my-4">
            <!--los turbo frames son utilizados para reemplazar bloques dentro de la aplicacion-->
            <%= link_to new_chapter_path, id:"create_chapter_welcome", data: {turbo_frame: 'modal'} do %>
                <div class="p-3 bg-chapterStrong text-white font-semibold text-sm rounded-lg">
                    Crear capítulo
                </div>
            <% end %>
        </div>


    </div>

</section>