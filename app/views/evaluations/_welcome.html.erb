<%= turbo_frame_tag 'modal' %>
<section class="flex justify-around items-center p-32" id="evaluations_all">
    <div>
        <%= image_tag("6099984.jpg", width: "400")%>
    </div>

    <div>
        <h1 class="text-center text-3xl font-bold text-evaluationStrong">Evaluaciones</h1>
        <p class="text-center py-2 font-semibold text-evaluationStrong">
        En esta sección, encontrarás todas las evaluaciones disponibles. <br>
        También podrás crear nuevas, las evaluaciones se podrán añadir a una encuesta.
            
        </p>

        <div class="flex justify-center my-4">
            <!--los turbo frames son utilizados para reemplazar bloques dentro de la aplicacion-->
            <%= link_to new_evaluation_path, id:"create_evaluation_welcome", data: {turbo_frame: 'modal'} do %>
                <div class="p-3 bg-evaluationStrong text-white font-semibold text-sm rounded-lg">
                    Crear evaluación
                </div>
            <% end %>
        </div>


    </div>

</section>